{
  "framework": "vite",
  "crons": [
    {
      "path": "/api/cron/daily-inactivity",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/test-reminders",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/weekly-report",
      "schedule": "0 16 * * 0"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
